# Réécriture vers le point d'entrée unique. Sans mod_rewrite, désactivez
# « URLs propres » dans les Réglages : l'application bascule seule sur les
# paramètres de requête.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.php [QSA,L]
</IfModule>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
</IfModule>

# Le dossier des données ne doit jamais être servi, même si la racine web
# pointe par erreur sur la racine du projet.
<FilesMatch "\.(json|jsonl|lock|md)$">
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Order deny,allow
        Deny from all
    </IfModule>
</FilesMatch>

DirectoryIndex index.php
Options -Indexes
